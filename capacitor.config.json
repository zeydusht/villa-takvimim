{
  "appId": "com.zeydtekin.villatakvim",
  "appName": "Villa Takvimim",
  "webDir": "www",
  "backgroundColor": "#10180D",
  "ios": {
    "contentInset": "never",
    "scheme": "VillaTakvim"
  },
  "android": {
    "backgroundColor": "#10180D"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": false,
      "backgroundColor": "#10180D",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    }
  }
}

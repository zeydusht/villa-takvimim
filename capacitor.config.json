{
  "appId": "com.zeydtekin.villatakvim",
  "appName": "Villa Takvim",
  "webDir": "www",
  "backgroundColor": "#0B5B57",
  "ios": {
    "contentInset": "never",
    "scheme": "VillaTakvim"
  },
  "android": {
    "backgroundColor": "#0B5B57"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "launchAutoHide": true,
      "backgroundColor": "#0B5B57",
      "showSpinner": false
    },
    "StatusBar": {
      "overlaysWebView": true,
      "style": "LIGHT"
    }
  }
}
